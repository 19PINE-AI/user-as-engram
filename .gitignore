# Vendored upstream fork — kept locally for runs, not part of the public repo.
# The curated changes live in code/; apply them onto a karpathy/nanochat clone.
nanochat/

# Large training artifacts — don't version these
nanochat_base/
*.parquet
*.bin

# Model checkpoints (can be many GB)
**/model.pt
**/*.safetensors

# Generated console logs
results/*.console.log
results/*.log
logs/

# Python + LaTeX byproducts
__pycache__/
*.pyc
*.aux
*.log
*.out
texput.log

# Local agent / session scratch
.claude/

# Editor / OS
.DS_Store
.idea/
.vscode/
