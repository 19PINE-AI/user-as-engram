# Root-level dev workspace (full local checkout incl. .venv). The vendored,
# tracked harness lives at code/nanochat_harness/ — root-anchored so it is
# NOT ignored.
/nanochat/

# Large training artifacts — don't version these
/nanochat_base/
*.parquet
*.bin
# vendored harness: ignore only its local virtualenv / run outputs
code/nanochat_harness/.venv/
code/nanochat_harness/runs/

# Model checkpoints (can be many GB)
**/model.pt
**/*.safetensors

# Generated console logs
results/*.console.log
results/*.log
logs/

# Python + LaTeX byproducts
__pycache__/
*.pyc
*.aux
*.log
*.out
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
texput.log

# Local agent / session scratch
.claude/

# Editor / OS
.DS_Store
.idea/
.vscode/
